{
  "manifest_version": 3,
  "name": "AmagiFlix Companion",
  "short_name": "AmagiFlix",
  "description": "Tracks playback only for videos in the public AmagiFlix catalog.",
  "version": "2.2.0",
  "permissions": ["storage", "webNavigation"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://theamagiflix.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["youtube-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://theamagiflix.com/*"],
      "js": ["app-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
